.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 80rpx;
  box-sizing: border-box;
  background:
    linear-gradient(160deg, rgba(58, 166, 255, 0.12), transparent 32%),
    linear-gradient(20deg, rgba(255, 138, 42, 0.14), transparent 30%),
    #08090d;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 26rpx;
}

.eyebrow {
  color: #3aa6ff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 10rpx;
  color: #fff7ec;
  font-size: 46rpx;
  font-weight: 800;
}

.ghost {
  color: #3aa6ff;
  background: transparent;
  border: 1rpx solid rgba(58, 166, 255, 0.45);
}

.filters,
.summary,
.booking,
.editor {
  padding: 24rpx;
  background: rgba(16, 18, 25, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
}

.filters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field.search,
.search-btn {
  grid-column: 1 / 3;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #9298a5;
  font-size: 22rpx;
}

.picker,
.input {
  min-height: 72rpx;
  padding: 0 18rpx;
  color: #f6f0e8;
  background: #0c1018;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.search-btn,
.save {
  height: 82rpx;
  color: #0a0a0d;
  background: #ff8a2a;
  border: none;
  border-radius: 8rpx;
  font-weight: 700;
}

.error {
  margin-top: 20rpx;
  padding: 20rpx;
  color: #ffb14a;
  background: rgba(255, 138, 42, 0.12);
  border-radius: 8rpx;
  font-size: 24rpx;
}

.summary {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.big {
  display: block;
  color: #f6f0e8;
  font-size: 42rpx;
  font-weight: 800;
}

.muted {
  color: #9298a5;
  font-size: 22rpx;
}

.price {
  color: #ff8a2a;
}

.booking-list {
  margin-top: 22rpx;
}

.booking {
  margin-bottom: 18rpx;
}

.booking-main {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.scene {
  color: #fff7ec;
  font-size: 30rpx;
  font-weight: 700;
}

.time,
.contact,
.meta {
  margin-top: 8rpx;
  color: #9298a5;
  font-size: 23rpx;
}

.amount {
  min-width: 148rpx;
  text-align: right;
  color: #ff8a2a;
  font-size: 34rpx;
  font-weight: 800;
}

.amount text {
  display: block;
  margin-top: 8rpx;
  color: #3aa6ff;
  font-size: 22rpx;
  font-weight: 500;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action {
  padding: 14rpx 18rpx;
  color: #f6f0e8;
  background: #0c1018;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  font-size: 24rpx;
}

.action.blue {
  color: #3aa6ff;
}

.action.cancel {
  color: #ff8a2a;
}

.editor {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 20;
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.5);
}

.editor-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: #fff7ec;
  font-size: 30rpx;
  font-weight: 700;
}

.close {
  color: #3aa6ff;
  font-size: 24rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.save {
  margin-top: 20rpx;
}
