<view class="page">
  <view class="hero">
    <view>
      <text class="eyebrow">XIAMU STUDIO</text>
      <view class="title">夏暮工作室预约</view>
    </view>
    <view class="admin-link" bindtap="goAdmin">后台</view>
  </view>

  <view class="panel">
    <view class="field">
      <text class="label">场景</text>
      <picker range="{{scenes}}" range-key="name" value="{{sceneIndex}}" bindchange="onSceneChange">
        <view class="picker">{{currentScene.name || '请选择场景'}}</view>
      </picker>
    </view>

    <view class="grid">
      <view class="field">
        <text class="label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="picker">{{form.date}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">人数</text>
        <input class="input" type="number" value="{{form.people_count}}" bindinput="onPeopleChange" />
      </view>
    </view>

    <view class="grid">
      <view class="field">
        <text class="label">开始</text>
        <picker range="{{timeSlots}}" value="{{startIndex}}" bindchange="onStartChange">
          <view class="picker">{{form.start_time}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">结束</text>
        <picker range="{{timeSlots}}" value="{{endIndex}}" bindchange="onEndChange">
          <view class="picker">{{form.end_time}}</view>
        </picker>
      </view>
    </view>

    <view class="grid">
      <view class="field">
        <text class="label">客户姓名</text>
        <input class="input" value="{{form.customer_name}}" placeholder="请输入姓名" bindinput="onNameChange" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" value="{{form.phone}}" placeholder="11 位手机号" bindinput="onPhoneChange" />
      </view>
    </view>

    <view class="field">
      <text class="label">微信号</text>
      <input class="input" value="{{form.wechat}}" placeholder="用于确认预约" bindinput="onWechatChange" />
    </view>
  </view>

  <view class="fee-panel">
    <view class="fee-head">
      <text>预计总金额</text>
      <text class="total">¥{{feeDisplay.total_fee}}</text>
    </view>
    <view class="fee-grid">
      <view>基础费 <text>¥{{feeDisplay.base_fee}}</text></view>
      <view>加班费 <text>¥{{feeDisplay.overtime_fee}}</text></view>
      <view>超人费 <text>¥{{feeDisplay.extra_person_fee}}</text></view>
      <view>应付订金 <text>¥{{feeDisplay.deposit_amount}}</text></view>
    </view>
    <view wx:if="{{fee.warnings.length}}" class="warnings">
      <view wx:for="{{fee.warnings}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <button class="submit" loading="{{submitting}}" bindtap="submitBooking">提交预约</button>

  <view class="notice">
    <view class="notice-title">预约须知</view>
    <view>订金用于锁定档期，支付后不退。</view>
    <view>单场 2 小时起租，赠送 1 小时化妆时间。</view>
    <view>15 分钟收尾不占档；前后订单紧接时会醒目提醒棚主协调客户。</view>
    <view>第二次及以后改签需额外加收 50 元。</view>
  </view>
</view>
