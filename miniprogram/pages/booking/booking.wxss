.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 64rpx;
  box-sizing: border-box;
  background:
    linear-gradient(145deg, rgba(255, 138, 42, 0.16), transparent 34%),
    linear-gradient(245deg, rgba(58, 166, 255, 0.16), transparent 38%),
    #08090d;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.eyebrow {
  color: #ff8a2a;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 12rpx;
  color: #fff7ec;
  font-size: 48rpx;
  font-weight: 700;
}

.admin-link {
  padding: 14rpx 20rpx;
  color: #3aa6ff;
  border: 1rpx solid rgba(58, 166, 255, 0.45);
  border-radius: 8rpx;
  font-size: 24rpx;
}

.panel,
.fee-panel,
.notice {
  padding: 28rpx;
  background: rgba(16, 18, 25, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.24);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #9298a5;
  font-size: 24rpx;
}

.picker,
.input {
  min-height: 78rpx;
  padding: 0 22rpx;
  color: #f6f0e8;
  background: #0c1018;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 78rpx;
  box-sizing: border-box;
}

.fee-panel {
  margin-top: 24rpx;
}

.fee-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  color: #f6f0e8;
}

.total {
  color: #ff8a2a;
  font-size: 52rpx;
  font-weight: 800;
}

.fee-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  color: #aeb5c2;
  font-size: 24rpx;
}

.fee-grid text {
  color: #f6f0e8;
  font-weight: 700;
}

.warnings {
  margin-top: 20rpx;
  color: #3aa6ff;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 28rpx;
  height: 92rpx;
  color: #0a0a0d;
  background: #ff8a2a;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.notice {
  margin-top: 28rpx;
  color: #9298a5;
  font-size: 24rpx;
  line-height: 1.75;
}

.notice-title {
  margin-bottom: 10rpx;
  color: #fff7ec;
  font-size: 30rpx;
  font-weight: 700;
}
